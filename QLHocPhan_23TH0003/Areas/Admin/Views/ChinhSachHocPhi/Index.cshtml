@model QLHocPhan_23TH0003.Models.ChinhSachHocPhi
@{

    ViewData["Title"] = "Quản lý chính sách học phí";
    var hocKys = ViewBag.HocKys as IEnumerable<QLHocPhan_23TH0003.Models.HocKy>
                 ?? Enumerable.Empty<QLHocPhan_23TH0003.Models.HocKy>();
    int? idHocKy = (int?)ViewBag.IdHocKy;
    String tenHocKy = "";
    var hocKy = hocKys.FirstOrDefault(x => x.Id == idHocKy);
    if (hocKy != null)
    {
        tenHocKy = hocKy.TenHocKy + " - " + hocKy.NamHoc;
    }
}
<style>
    .active {
        color: #f96332
    }
</style>
<div class="container-fluid py-4">

    <!-- Tiêu đề -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Quản lý chính sách học phí</h2>
            <p class="text-muted mb-0">
                Thiết lập đơn giá tín chỉ theo từng học kỳ.
            </p>
        </div>
    </div>

    <!-- Thông báo -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!hocKys.Any())
    {
        <div class="text-center py-5">
            <h6 class="text-muted">
                Chưa có học kỳ nào trong hệ thống.
            </h6>
            <p class="text-muted mb-0">
                Vui lòng tạo học kỳ trước khi thiết lập học phí.
            </p>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Danh sách học kỳ -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white py-3">
                        <h5 class="mb-0">Danh sách học kỳ</h5>
                    </div>

                    <div class="card-body">

                        <div class="table-responsive">
                            <table class="table table-hover align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 70px">STT</th>
                                        <th>Học kỳ</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @{
                                        var stt = 1;
                                    }

                                    @foreach (var hk in hocKys)
                                    {
                                        string active = hk.Id == ViewBag.IdHocKy ? "active" : "";
                                        <tr>
                                            <td>@stt</td>
                                            <td>
                                                <div class="fw-semibold">
                                                    <a href="@Url.Action("Index", new { IdHocKy = hk.Id })" class="@active">@hk.TenHocKy - Năm học @hk.NamHoc</a>
                                                </div>
                                            </td>
                                        </tr>

                                        stt++;
                                    }
                                </tbody>
                            </table>
                        </div>

                    </div>
                </div>
            </div>
            <!-- Form thêm chính sách -->
            <div class="col-lg-6">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-primary text-white py-3">
                        <h5 class="mb-0">Thiết lập học phí @tenHocKy</h5>
                    </div>

                    <div class="card-body">
                        @if (ViewBag.IdHocKy == null)
                        {
                            <div class="text-center py-5">
                                <h6 class="text-muted">
                                    Chưa chọn học kỳ áp dụng.
                                </h6>
                                <p class="text-muted mb-0">
                                    Vui lòng chọn học kỳ để thiết lặp học phí.
                                </p>
                            </div>
                        }
                        else
                        {
                            <form action="ChinhSachHocPhi/Eđit" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-3">
                                    @Html.HiddenFor(x => x.Id)
                                    @Html.HiddenFor(x => x.IdHocKy)
                                </div>

                                <div class="mb-3">
                                    <label for="DonGiaTinChi"
                                           class="form-label fw-semibold">
                                        Đơn giá tín chỉ (VNĐ)
                                    </label>
                                    <div class="input-group">
                                        @Html.TextBoxFor(x => x.DonGiaTinChi,"{0:0}", new { @class = "form-control", @placeholder="VD: 500.000",
                                        @autocomplete = "off", @type = "number", @min = "0",
                                                                @step = "1"})
                                        <span class="input-group-text">VNĐ</span>
                                    </div>
                                </div>

                                <button type="submit"
                                        class="btn btn-primary w-100">
                                    <i class="bi bi-save me-1"></i>
                                    Lưu chính sách học phí
                                </button>
                            </form>
                        }
                        
                    </div>
                </div>
            </div>
        </div>
    }
    
</div>

